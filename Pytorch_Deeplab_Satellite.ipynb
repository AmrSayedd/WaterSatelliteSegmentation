        "class FusionDeepLab(nn.Module):\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "\n",
        "        # Fusion layers\n",
        "        self.rgb_conv  = nn.Conv2d(3, 32, 3, padding=1)\n",
        "        self.nir_conv  = nn.Conv2d(1, 16, 3, padding=1)\n",
        "        self.swir_conv = nn.Conv2d(2, 16, 3, padding=1)\n",
        "        self.ndwi_conv = nn.Conv2d(1, 8, 3, padding=1)\n",
        "\n",
        "        self.fuse_conv = nn.Conv2d(32+16+16+8, 64, 1)\n",
        "        self.project   = nn.Conv2d(64, 3, 1)\n",
        "\n",
        "        # DeepLabV3+\n",
        "        self.deeplab = smp.DeepLabV3Plus(\n",
        "            encoder_name=\"resnet34\",\n",
        "            encoder_weights=\"imagenet\",\n",
        "            in_channels=3,\n",
        "            classes=1,\n",
        "            activation=None\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "\n",
        "        rgb  = x[:, :3]\n",
        "        nir  = x[:, 3:4]\n",
        "        swir = x[:, 4:6]\n",
        "        ndwi = x[:, 6:7]\n",
        "\n",
        "        rgb_feat  = torch.relu(self.rgb_conv(rgb))\n",
        "        nir_feat  = torch.relu(self.nir_conv(nir))\n",
        "        swir_feat = torch.relu(self.swir_conv(swir))\n",
        "        ndwi_feat = torch.relu(self.ndwi_conv(ndwi))\n",
        "\n",
        "        fused = torch.cat([rgb_feat, nir_feat, swir_feat, ndwi_feat], dim=1)\n",
        "        fused = torch.relu(self.fuse_conv(fused))\n",
        "        fused = self.project(fused)\n",
        "\n",
        "        return self.deeplab(fused)"
      ],
      "metadata": {
        "id": "8ytTh0lFaFdw"
      },
      "execution_count": 13,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def dice_loss(pred, target, smooth=1e-6):\n",
        "    pred = torch.sigmoid(pred)\n",
        "\n",
        "    pred = pred.contiguous().view(-1)\n",
        "    target = target.contiguous().view(-1)\n",
        "\n",
        "    intersection = (pred * target).sum()\n",
        "    dice = (2. * intersection + smooth) / (\n",
        "        pred.sum() + target.sum() + smooth\n",
        "    )\n",
        "\n",
        "    return 1 - dice\n",
        "\n",
        "\n",
        "bce_loss = nn.BCEWithLogitsLoss()\n",
        "\n",
        "def combined_loss(pred, target):\n",
        "    return bce_loss(pred, target) + dice_loss(pred, target)\n",
        "\n",
        "\n",
        "def iou_score(pred, target, threshold=0.5):\n",
        "    pred = torch.sigmoid(pred)\n",
        "    pred = (pred > threshold).float()\n",
        "\n",
        "    intersection = (pred * target).sum()\n",
        "    union = pred.sum() + target.sum() - intersection\n",
        "\n",
        "    return (intersection + 1e-6) / (union + 1e-6)"
      ],
      "metadata": {
        "id": "HPqL_chlY5nK"
      },
      "execution_count": 14,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "\n",
        "model = FusionDeepLab().to(device)\n",
        "optimizer = optim.AdamW(model.parameters(), lr=1e-4)\n",
        "\n",
        "scaler = torch.cuda.amp.GradScaler(enabled=torch.cuda.is_available())\n",
        "\n",
        "\n",
        "\n",
        "def train_one_epoch(model, loader):\n",
        "    model.train()\n",
        "    total_loss = 0\n",
        "    total_iou = 0\n",
        "\n",
        "    loop = tqdm(loader)\n",
        "\n",
        "    for images, masks in loop:\n",
        "        images = images.to(device)\n",
        "        masks = masks.to(device)\n",
        "\n",
        "        optimizer.zero_grad()\n",
        "\n",
        "        with torch.cuda.amp.autocast(enabled=torch.cuda.is_available()):\n",
        "            outputs = model(images)\n",
        "            loss = combined_loss(outputs, masks)\n",
        "\n",
        "        scaler.scale(loss).backward()\n",
        "        scaler.step(optimizer)\n",
        "        scaler.update()\n",
        "\n",
        "        total_loss += loss.item()\n",
        "        total_iou += iou_score(outputs, masks).item()\n",
        "\n",
        "        loop.set_postfix(loss=loss.item())\n",
        "\n",
        "    return total_loss / len(loader), total_iou / len(loader)\n",
        "\n",
        "\n",
        "def validate(model, loader):\n",
        "    model.eval()\n",
        "    total_loss = 0\n",
        "    total_iou = 0\n",
        "\n",
        "    with torch.no_grad():\n",
        "        for images, masks in loader:\n",
        "            images = images.to(device)\n",
        "            masks = masks.to(device)\n",
        "\n",
        "            outputs = model(images)\n",
        "            loss = combined_loss(outputs, masks)\n",
        "\n",
        "            total_loss += loss.item()\n",
        "            total_iou += iou_score(outputs, masks).item()\n",
        "\n",
        "    return total_loss / len(loader), total_iou / len(loader)"
      ],

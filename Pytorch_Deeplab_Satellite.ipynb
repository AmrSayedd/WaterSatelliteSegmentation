      "source": [
        "def visualize_predictions(model, X, y, num_samples=3):\n",
        "    model.eval()\n",
        "    device = next(model.parameters()).device\n",
        "\n",
        "    with torch.no_grad():\n",
        "        for i in range(num_samples):\n",
        "            img = X[i:i+1].to(device)   # shape (1, 7, H, W)\n",
        "            mask = y[i]                 # shape (1, H, W)\n",
        "\n",
        "            output = model(img)         # shape (1, 1, H, W)\n",
        "            pred = torch.sigmoid(output).cpu().numpy()[0,0]\n",
        "            pred_binary = (pred > 0.5).astype(np.float32)\n",
        "\n",
        "            # Reconstruct RGB from input\n",
        "            rgb = X[i].cpu().numpy()[:3]           # (3, H, W)\n",
        "            rgb = np.transpose(rgb, (1, 2, 0))     # (H, W, 3)\n",
        "            rgb = rgb[..., ::-1]                    # BGR → RGB for display\n",
        "\n",
        "            plt.figure(figsize=(15,5))\n",
        "\n",
        "            # Input RGB\n",
        "            plt.subplot(1,3,1)\n",
        "            plt.imshow(rgb)\n",
        "            plt.title(\"Input RGB\")\n",
        "            plt.axis(\"off\")\n",
        "\n",
        "            # Ground Truth\n",
        "            plt.subplot(1,3,2)\n",
        "            plt.imshow(mask.squeeze().cpu().numpy(), cmap='Blues')\n",
        "            plt.title(\"Ground Truth\")\n",
        "            plt.axis(\"off\")\n",
        "\n",
        "            # Prediction\n",
        "            plt.subplot(1,3,3)\n",
        "            plt.imshow(pred_binary, cmap='Blues')\n",
        "            plt.title(\"Prediction\")\n",
        "            plt.axis(\"off\")\n",
        "\n",
        "            plt.show()\n",
        "\n",
        "\n",
        "visualize_predictions(model, X_val, y_val, num_samples=10)"
      ],
